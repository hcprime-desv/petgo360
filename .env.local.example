# Copie para .env.local e preencha. Não commitar o .env.local de verdade.
# (Prefixo NEXT_PUBLIC_ porque o SDK do Firebase também roda no navegador
# — nos listeners em tempo real e no formulário de parceiro — mesmo
# agora que existe um servidor Node.js de verdade (SSR/ISR, ver
# next.config.js: output "standalone") fazendo a leitura inicial das
# páginas de conteúdo.)

# --- Firebase ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Tenant deste site dentro do banco compartilhado (dados/{tenant}/<colecao>)
# — o mesmo `path` do cliente PetGo360 / Portal Pet na coleção `cliente` do
# painel (petGo360). Obrigatório, sem valor padrão. Case-sensitive!
NEXT_PUBLIC_PETHUB_PATH=

# Segredo compartilhado com o painel pra chamar POST /api/revalidate
# (invalida o cache de rota do Next.js logo depois de criar/editar/excluir
# um registro no painel, em vez de esperar o `revalidate` de cada página
# — ver app/api/revalidate/route.ts). Roda só no servidor, não leva
# NEXT_PUBLIC_.
REVALIDATE_SECRET=
